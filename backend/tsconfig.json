{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    // Temporarily disable these for development
    "noImplicitOverride": false,
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "src/automation/**/*",
    "src/application/automation/**/*",
    "src/domain/automation/**/*",
    "src/infrastructure/automation/**/*",
    "src/services/automation/**/*",
    "src/services/workflow/**/*",
    "src/infrastructure/queue/**/*",
    "src/services/fileProcessingService.ts",
    "src/services/file-processing/parsers/XlsxParser.ts",
    "src/routes/automation.ts",
    "**/*.backup"
  ]
}
